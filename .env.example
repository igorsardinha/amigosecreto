# Desenvolvimento local (SQLite)
DATABASE_URL="file:./dev.db"

# Produção (Postgres/Neon) — definidos automaticamente pela integração Neon na Vercel
# DATABASE_URL="postgresql://..."
# DATABASE_URL_UNPOOLED="postgresql://..."

# Senha do painel Superadmin (/superadmin)
ADMIN_SECRET="admin123"

# URL pública (opcional; por padrão usa o host da requisição)
# NEXT_PUBLIC_APP_URL="https://seu-dominio.com"

# E-mail opcional via Resend (https://resend.com)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Amigo Secreto <sorteio@seu-dominio.com>"
